<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBarReceiving"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="#4A90E2"
        android:visibility="gone" />

    <!-- Content Layout -->
    <LinearLayout
        android:id="@+id/contentLayoutReceiving"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Header Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Receiving Notes Icon"
                    android:src="@drawable/inventory_icon"
                    app:tint="#4A90E2" />

                <TextView
                    android:id="@+id/textViewTitleReceiving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Receiving Notes"
                    android:textColor="#1E1E1E"

                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
<!--        </androidx.cardview.widget.CardView>-->

        <!-- RecyclerView Container -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewReceiving"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="vertical" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
