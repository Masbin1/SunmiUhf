<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBarProductAsset"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="#4A90E2"
        android:visibility="gone" />

    <!-- Content Layout -->
    <LinearLayout
        android:id="@+id/contentLayoutProductAsset"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- Header Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Product Asset"
                    android:src="@drawable/inventory_icon"
                    app:tint="#4A90E2" />

                <TextView
                    android:id="@+id/textViewTitleReceiving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Product Asset"
                    android:textColor="#1E1E1E"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        <!-- Search bar -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editSearchProductAsset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:hint="Search asset name or code..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableEnd="@drawable/ic_clear"
            android:background="@drawable/bg_search_rounded"
            android:textColor="#1E1E1E"
            android:textColorHint="#9AA3AD"
            android:textSize="14sp"
            android:singleLine="true"
            android:gravity="center_vertical" />

        <!-- Search Inline Loading Indicator (subtle, non-blocking) -->
        <ProgressBar
            android:id="@+id/progressBarSearchProductAsset"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="4dp"
            android:indeterminate="true"
            android:indeterminateTint="#4A90E2"
            android:visibility="invisible" />

        <!-- Empty state (hidden by default) -->
        <TextView
            android:id="@+id/txtEmptyProductAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="No assets found"
            android:textColor="#888888"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- RecyclerView Container -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewProductAsset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="vertical" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
