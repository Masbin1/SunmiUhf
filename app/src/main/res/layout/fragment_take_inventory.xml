<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.sunmi.uhf.fragment.takeinventory.TakeInventoryModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/defaultMainColor">

        <include
            android:id="@+id/title_ll"
            layout="@layout/layout_take_inventory_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/sunmi_100px"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{vm}" />

        <View
            android:id="@+id/title_line"
            android:layout_width="0dp"
            android:layout_height="@dimen/sunmi_1px"
            android:background="@color/dividerColor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_ll" />


        <include
            android:id="@+id/basic_ll"
            layout="@layout/layout_take_inventory_basic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_line"
            app:vm="@{vm}" />

        <LinearLayout
            android:id="@+id/receiving_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingLeft="@dimen/sunmi_28px"
            android:paddingTop="@dimen/sunmi_20px"
            android:paddingRight="@dimen/sunmi_28px"
            android:paddingBottom="@dimen/sunmi_20px"
            android:visibility="@{vm.receivingVisible?View.VISIBLE:View.GONE}"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/basic_ll">

            <TextView
                android:id="@+id/receiving_product_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{vm.receivingProduct}"
                android:textColor="@color/majorTextColor"
                android:textSize="@dimen/sunmi_32ps" />

            <TextView
                android:id="@+id/receiving_lot_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sunmi_12px"
                android:text="@{vm.receivingLot}"
                android:textColor="@color/primaryTextColor"
                android:textSize="@dimen/sunmi_28ps" />

            <TextView
                android:id="@+id/receiving_qty_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sunmi_8px"
                android:text="@{vm.receivingQty}"
                android:textColor="@color/primaryTextColor"
                android:textSize="@dimen/sunmi_28ps" />

            <TextView
                android:id="@+id/receiving_uom_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sunmi_8px"
                android:text="@{vm.receivingUom}"
                android:textColor="@color/primaryTextColor"
                android:textSize="@dimen/sunmi_28ps" />

            <TextView
                android:id="@+id/receiving_rfid_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sunmi_8px"
                android:text="@{vm.receivingRfid}"
                android:textColor="@color/primaryTextColor"
                android:textSize="@dimen/sunmi_28ps" />
        </LinearLayout>

        <include
            android:id="@+id/filter_ll"
            layout="@layout/layout_take_inventory_filter"
            android:layout_width="0dp"
            android:layout_height="@dimen/sunmi_132px"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/receiving_info_container"
            app:vm="@{vm}" />

        <include
            android:id="@+id/bottom_ll"
            layout="@layout/layout_take_inventory_bottom"
            android:layout_width="0dp"
            android:layout_height="@dimen/sunmi_112px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:vm="@{vm}" />


        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/bottom_ll"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filter_ll">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include
                    layout="@layout/layout_take_inventory_header_info"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sunmi_80px"
                    app:vm="@{vm}" />

                <View
                    android:id="@+id/head_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sunmi_1px"
                    android:background="@color/dividerColor" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/label_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </HorizontalScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>